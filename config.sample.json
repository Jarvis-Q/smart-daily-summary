{
  "server": {
    "url": "${SERVER_URL}",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json",
      "X-Api-Key": "${DAILY_SUMMARY_TOKEN}"
    }
  },
  "local_output_dir": "~/Documents/worklog/",
  "extra_git_dirs": [],
  "projects_cache_path": "~/.cache/daily-summary/projects.json",
  "payload_template": {
    "workDate": "{{date}}",
    "status": "1",
    "remark": "备注信息",
    "items": "{{tasks}}"
  },
  "task_item_template": {
    "workCategory": "{{work_category}}",
    "workDetail": "{{work_detail}}",
    "workHours": "{{hours}}",
    "aiHours": "{{ai_hours}}",
    "tokenConsume": "{{token_consume}}",
    "projectId": "{{project_id}}",
    "chandaoId": "",
    "sortOrder": 1
  },
  "defaults": {
    "work_category": "dev",
    "project_id": "",
    "project_name": ""
  }
}
